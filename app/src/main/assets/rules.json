{
  "version": 3,
  "launchWindowMs": 12000,

  "_说明": "跳/关规则。注意：不要往 skipPatterns 里加「广告」这种纯标签词，信息流里每条广告卡都有「广告」标签，点了就是点进广告。apps 里可以给单个 App 加 splashOnlyMs（只在前 N 毫秒内工作）和专属正则。",

  "skipPatterns": [
    "^跳过",
    "^点击跳过",
    "跳过.{0,8}(广告|\\d+\\s*[s秒S])",
    "^关闭广告$",
    "^skip(\\s*ad)?$",
    "^skip\\b"
  ],

  "closePatterns": [
    "^关闭广告$",
    "^残忍离开$",
    "^以后再说$",
    "^下次再说$",
    "^直接进入$",
    "^skip$",
    "^close ad$"
  ],

  "aggressiveClosePatterns": [
    "^关闭$",
    "^×$",
    "^x$",
    "^X$",
    "^我知道了$",
    "^我知道啦$",
    "^不感兴趣$",
    "^暂时不需要$",
    "^close$",
    "^no,? thanks$",
    "^not now$"
  ],

  "skipIds": [
    "btn_skip",
    "tv_skip",
    "skip_btn",
    "skipview",
    "skip_view",
    "ad_skip",
    "adskip",
    "splash_skip",
    "skip_ad",
    "iv_skip",
    "img_skip"
  ],

  "apps": {
    "com.baidu.tieba": {
      "splashOnlyMs": 15000,
      "skipPatterns": ["^跳过\\s*\\d*\\s*[sS秒]?$"],
      "closePatterns": ["^关闭广告$"]
    },
    "com.taobao.idlefish": {
      "splashOnlyMs": 15000,
      "skipPatterns": ["^跳过\\s*\\d*\\s*[sS秒]?$"],
      "closePatterns": ["^关闭广告$"]
    }
  }
}
