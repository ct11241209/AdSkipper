{
  "version": 4,
  "launchWindowMs": 12000,
  "_说明": "跳/关规则。注意：不要往 skipPatterns 里加「广告」这种纯标签词，信息流里每条广告卡都有「广告」标签，点了就是点进广告。apps 里可以给单个 App 加 splashOnlyMs（只在前 N 毫秒内工作）和专属正则。v4 新增：倒计时在前面的文案（5s | 跳过 / 5 跳过）、更多广告 SDK 的跳过控件 id、一加(ColorOS) 自带 App 与国内主流 App 的开屏窗口限制。",
  "skipPatterns": [
    "^跳过",
    "^点击跳过",
    "跳过.{0,8}(广告|\\d+\\s*[s秒S])",
    "^\\d{1,2}\\s*[sS秒]?\\s*[|｜/·]?\\s*跳过\\s*[>》]?$",
    "^关闭广告$",
    "^关闭广告\\s*[\\d>》]*$",
    "^skip(\\s*ad)?$",
    "^skip\\b",
    "^skip\\s*\\d+\\s*[sS]?$"
  ],
  "closePatterns": [
    "^关闭广告$",
    "^残忍离开$",
    "^以后再说$",
    "^下次再说$",
    "^直接进入$",
    "^skip$",
    "^close ad$"
  ],
